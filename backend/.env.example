# Copy this file to .env and paste your own key in.
# .env is gitignored and must never be committed.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Origin allowed to call this API. The deployed frontend URL goes here later.
FRONTEND_ORIGIN=

# Optional. Enables the company search bar so users can pull a published
# transcript instead of uploading a file. Free key, ~25 requests a day:
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
